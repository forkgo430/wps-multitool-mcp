        { "action": "exportChartAsImage", "app": "excel", "inline": true, "note": "导出图片供插入" },
        { "action": "createDocument", "app": "word", "snapshot": true, "note": "建组会报告（自研三段式：本周进展/问题与卡点/下周计划）" },
        { "action": "insertText", "app": "word", "note": "正文写入（图表图插 insertImage）" },
