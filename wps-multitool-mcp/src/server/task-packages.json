{
  "_note": [
    "任务包模板（三层意图架构的导航层）。真相源，由 src/tools/common/intent.ts 运行时加载。",
    "",
    "match 关键词的场景依据（B5 任务卡红线 6：不许拍脑袋编）——每包 steps 里的动作全部来自",
    "S1-REPORT §3 判定'支持'的 JSAPI 动作集（Linux）与 Windows 侧注册工具的交集场景：",
    "  weekly_report    —— 周报=读数据+图表+成文+转 PDF，是办公自动化最常见组合（S1 Excel #5/#33 替代路径 + Word #108/#118 + Common #284）",
    "  official_document—— 公文有固定排版规范（页面设置/标题样式/页码），Word 页面设置 S1 #123/#162 实测支持",
    "  contract_review  —— 合同审阅走修订模式：Word 修订族 S1 #135-140（enableTrackChanges/replaceRange/revisions）全支持",
    "  paper_format     —— 论文三件套（样式/目录/题注交叉引用）S1 #134/#104/#151/#158 全支持",
    "  data_entry       —— 数据录入=建簿+写值+公式+保存，S1 Excel #102/#6/#11 支持",
    "  demo_beautify    —— 演示美化=背景/字体统一/切换，S1 PPT #228/#275/#227 支持",
    "  data_charts      —— 图表化=选区→建图→导出，S1 Excel #33 复核路径 Shapes.AddChart + #35",
    "  format_unify     —— 批量格式=条件格式+清除重设，S1 Excel #17-19/#16 支持",
    "  meeting_notes    —— 纪要=建文档+列表+保存，S1 Word #108/#164 支持",
    "  project_tracker  —— 进度表=建簿+写表+条件格式+冻结，S1 Excel #77/#17 支持",
    "  compare_analysis —— 对比=读数+公式+图表+导出，与 weekly_report 同链路不同措辞",
    "  template_fill    —— 模板填字段=打开+替换+另存，S1 Word #108/#120/#129 + Common #280",
    "",
    "学术五件套（第 3 期任务卡，排在 deckkit E3 之后）：",
    "  thesis_skeleton  —— 章级样式+题注+交叉引用走 addCaption 的 SEQ 层（10-28 探针已证图表目录能收集）；",
    "  literature_matrix—— 文献矩阵表（作者/方法/结论三列起步），insertTable 的 rows/cols/data 直接带内容",
    "                     （ps1 实读 $p.rows/$p.cols/$p.data——B5 红线 6：动作名不拍脑袋编）",
    "  defense_deck     —— 对接 deckkit 的 build_ppt_deck（wps_ppt_build_deck 工具，theme 缺省学术蓝）+ 逐页导图复核",
    "  journal_format   —— 自研中文期刊版式规范（字体/行距/图表编号/字数区间都是自创口径，note 里逐条标注，",
    "                     投稿前须对目标刊复核）；行距走 setParagraph（ps1 无 setLineSpacing 动作）",
    "  group_meeting_report —— 周报包的学术变体（三段式：进展/卡点/计划）",
    "",
    "not_for（第 3 期新字段）：反例词命中即【排除】本包——即使触发词也命中（反例优先）。",
    "用途：学术包与既有包子串交叠时的边界（如「期刊论文格式」同时含「论文格式」，靠 match 词总长",
    "特异度 tie-break 定胜负；not_for 则兜住「学位论文格式」这类不该进期刊包的话术）。",
    "",
    "steps 里的 action 是【Windows 注册工具的语义名】（Linux 侧由动作层映射到 jsAsynCall method）；",
    "app 是会话路由（word/excel/ppt/common）；confirm_before 列破坏性动作（执行前应征询）；",
    "snapshot 列写动作前建议自动快照（auto-snapshot 机制对齐）。",
    "",
    "v2（2026-11-05，意图一期·服务端执行，决策者）：",
    "  execute:'server' 的包由 wps_run_task 在服务端一次跑完，中间结果不出服务端（INTENT-DESIGN §4.2）；",
    "  steps 新增必填 tool（注册工具名，消灭语义名→工具名断点）与可选 params（字面量 +",
    "  {{args.x}}/{{steps.N.data.x}} 引用，引擎深解析）；execute 缺省 'model'＝v1 行为（模型按 steps 逐步执行）。",
    "  weekly_report 为首个试点包；其余包维持 'model'，逐包迁移前须真机验证。"
  ],
  "packages": [
    {
      "task": "weekly_report",
      "title": "周报生成",
      "execute": "server",
      "match": ["周报", "本周总结", "工作周报", "weekly report", "本周汇报", "周总结"],
      "steps": [
        { "action": "getRangeData", "tool": "wps_excel_read_range", "app": "excel", "params": {}, "note": "读本周数据" },
        { "action": "createChart", "tool": "wps_excel_create_chart", "app": "excel", "params": {}, "note": "数据成图" },
        { "action": "exportChartAsImage", "tool": "wps_excel_export_chart_as_image", "app": "excel", "inline": true, "params": {}, "note": "导出图表图片" },
        { "action": "createDocument", "tool": "wps_word_create_document", "app": "word", "snapshot": true, "params": {}, "note": "建周报文档" },
        { "action": "insertText", "tool": "wps_word_insert_text", "app": "word", "params": { "text": "{{args.body}}" }, "note": "写入正文（正文来自运行参数 args.body）" },
        { "action": "convertToPDF", "tool": "wps_convert_to_pdf", "app": "common", "params": {}, "note": "转 PDF 归档" }
      ],
      "confirm_before": ["createDocument"]
    },
    {
      "task": "official_document",
      "title": "公文排版",
      "match": ["公文", "红头文件", "公文格式", "公文排版", "官方文件排版"],
      "steps": [
        { "action": "createDocument", "app": "word", "snapshot": true, "note": "建公文" },
        { "action": "setPageSetup", "app": "word", "note": "页边距/纸型按公文规范" },
        { "action": "applyStyle", "app": "word", "note": "标题/正文样式" },
        { "action": "addPageNumber", "app": "word", "note": "页码" },
        { "action": "save", "app": "common", "note": "保存" }
      ],
      "confirm_before": ["createDocument"]
    },
    {
      "task": "contract_review",
      "title": "合同修订（走修订模式）",
      "match": ["合同修订", "修订合同", "审阅合同", "合同审阅", "改合同", "修订模式"],
      "steps": [
        { "action": "openDocument", "app": "word", "note": "打开合同" },
        { "action": "enableTrackChanges", "app": "word", "note": "开修订模式" },
        { "action": "findReplace", "app": "word", "note": "逐处修改" },
        { "action": "getDocumentRevisions", "app": "word", "note": "列修订供确认" },
        { "action": "save", "app": "common", "note": "保存" }
      ],
      "confirm_before": ["save"]
    },
    {
      "task": "paper_format",
      "title": "论文排版",
      "match": ["论文排版", "毕业论文", "论文格式", "参考文献排版", "学位论文"],
      "steps": [
        { "action": "openDocument", "app": "word" },
        { "action": "setPageSetup", "app": "word", "note": "页边距/行距" },
        { "action": "applyStyle", "app": "word", "note": "标题层级样式" },
        { "action": "generateTOC", "app": "word", "note": "目录" },
        { "action": "addCaption", "app": "word", "note": "图表题注" },
        { "action": "insertCrossReference", "app": "word", "note": "交叉引用" },
        { "action": "getDocumentStats", "app": "word", "note": "字数核查" }
      ],
      "confirm_before": []
    },
    {
      "task": "data_entry",
      "title": "数据录入",
      "match": ["数据录入", "录入数据", "填数据", "数据填表", "把数据填进去"],
      "steps": [
        { "action": "createWorkbook", "app": "excel", "snapshot": true },
        { "action": "setRangeData", "app": "excel", "note": "批量写入" },
        { "action": "setFormula", "app": "excel", "note": "合计/校验列" },
        { "action": "save", "app": "common" }
      ],
      "confirm_before": []
    },
    {
      "task": "demo_beautify",
      "title": "演示美化",
      "match": ["美化PPT", "演示美化", "PPT美化", "统一演示风格", "幻灯片美化"],
      "steps": [
        { "action": "setSlideBackground", "app": "ppt" },
        { "action": "unifyFont", "app": "ppt", "note": "全篇字体统一" },
        { "action": "setSlideTransition", "app": "ppt", "note": "统一切换" },
        { "action": "save", "app": "common" }
      ],
      "confirm_before": []
    },
    {
      "task": "data_charts",
      "title": "数据图表化",
      "match": ["图表化", "做图表", "数据可视化", "画个图表", "趋势图"],
      "steps": [
        { "action": "getRangeData", "app": "excel", "note": "确认数据区" },
        { "action": "createChart", "app": "excel", "note": "建图表" },
        { "action": "exportChartAsImage", "app": "excel", "inline": true }
      ],
      "confirm_before": []
    },
    {
      "task": "format_unify",
      "title": "批量格式统一",
      "match": ["格式统一", "统一格式", "批量格式", "把格式改成一致"],
      "steps": [
        { "action": "addConditionalFormat", "app": "excel", "note": "规则化高亮" },
        { "action": "clearFormats", "app": "excel", "note": "清残留格式" },
        { "action": "autoFit", "app": "excel", "note": "行列自适应" },
        { "action": "save", "app": "common" }
      ],
      "confirm_before": []
    },
    {
      "task": "meeting_notes",
      "title": "会议纪要",
      "match": ["会议纪要", "纪要整理", "整理会议记录", "会议记录成文"],
      "steps": [
        { "action": "createDocument", "app": "word", "snapshot": true },
        { "action": "insertText", "app": "word", "note": "议题/结论分节写入" },
        { "action": "addList", "app": "word", "note": "待办列表" },
        { "action": "save", "app": "common" }
      ],
      "confirm_before": ["createDocument"]
    },
    {
      "task": "project_tracker",
      "title": "项目进度表",
      "match": ["进度表", "项目计划表", "项目进度", "排期表", "甘特"],
      "steps": [
        { "action": "createWorkbook", "app": "excel", "snapshot": true },
        { "action": "setRangeData", "app": "excel", "note": "任务/负责人/日期" },
        { "action": "addConditionalFormat", "app": "excel", "note": "超期高亮" },
        { "action": "freezePanes", "app": "excel", "note": "冻结表头" },
        { "action": "save", "app": "common" }
      ],
      "confirm_before": []
    },
    {
      "task": "compare_analysis",
      "title": "对比分析",
      "match": ["对比分析", "环比", "同比", "两个表对比", "差异分析"],
      "steps": [
        { "action": "getRangeData", "app": "excel", "note": "读两期数据" },
        { "action": "setFormula", "app": "excel", "note": "差值/百分比列" },
        { "action": "createChart", "app": "excel", "note": "对比图" },
        { "action": "exportChartAsImage", "app": "excel", "inline": true }
      ],
      "confirm_before": []
    },
    {
      "task": "template_fill",
      "title": "模板填字段",
      "match": ["填字段", "模板填充", "按模板生成", "套模板", "占位符替换"],
      "steps": [
        { "action": "openDocument", "app": "word", "note": "打开模板" },
        { "action": "findReplace", "app": "word", "note": "占位符逐个替换" },
        { "action": "saveAs", "app": "common", "note": "另存成品" }
      ],
      "confirm_before": []
    },
    {
      "task": "thesis_skeleton",
      "title": "学位论文骨架",
      "match": ["论文骨架", "论文框架", "论文结构", "开题报告", "学位论文骨架", "毕业论文骨架", "论文提纲"],
      "steps": [
        { "action": "createDocument", "app": "word", "snapshot": true, "note": "建论文文档" },
        { "action": "addHeading", "app": "word", "note": "章级骨架：摘要/绪论/相关工作/方法/实验/结论/参考文献（章/节/小节三级，逐章录入）" },
        { "action": "setHeadingNumbering", "app": "word", "note": "章级自动编号（第X章/X.X/X.X.X）" },
        { "action": "addCaption", "app": "word", "note": "图表题注走 SEQ 层——图表目录靠它收集（10-28 探针已证）" },
        { "action": "insertCrossReference", "app": "word", "note": "正文引用题注（改编号自动跟）" },
        { "action": "insertTableOfFigures", "app": "word", "note": "图表目录（收集 SEQ 题注）" },
        { "action": "getOutline", "app": "word", "note": "结构复核" },
        { "action": "save", "app": "common", "note": "保存" }
      ],
      "not_for": ["论文排版", "论文格式"],
      "confirm_before": ["createDocument"]
    },
    {
      "task": "literature_matrix",
      "title": "综述表格化（文献矩阵）",
      "match": ["文献矩阵", "文献表格", "文献综述表", "综述表格", "文献整理表", "文献汇总表"],
      "steps": [
        { "action": "openDocument", "app": "word", "note": "打开综述文档" },
        { "action": "insertTable", "app": "word", "note": "文献矩阵表：作者/方法/结论三列起步（行数按文献数，data 直接带表头与条目）" },
        { "action": "formatTable", "app": "word", "note": "表头加粗、三线表口径（自研规范）" },
        { "action": "save", "app": "common", "note": "保存" }
      ],
      "not_for": ["参考文献排版", "引用格式"],
      "confirm_before": []
    },
    {
      "task": "defense_deck",
      "title": "答辩演示",
      "match": ["答辩PPT", "答辩演示", "答辩幻灯", "毕业答辩", "论文答辩", "答辩稿"],
      "steps": [
        { "action": "build_ppt_deck", "app": "ppt", "note": "deckkit 生成答辩骨架（wps_ppt_build_deck 工具：标题/章节/要点/结论四页型；theme 缺省学术蓝，可选 gov-red/business-gray）" },
        { "action": "exportSlideAsImage", "app": "ppt", "inline": true, "note": "逐页出图人工复核" },
        { "action": "save", "app": "common", "note": "保存" }
      ],
      "not_for": ["演示美化", "美化PPT"],
      "confirm_before": []
    },
    {
      "task": "journal_format",
      "title": "期刊投稿格式化",
      "match": ["期刊投稿", "期刊格式", "期刊排版", "投稿格式", "期刊论文格式", "杂志投稿"],
      "steps": [
        { "action": "openDocument", "app": "word", "note": "打开稿件" },
        { "action": "setPageSetup", "app": "word", "note": "A4；边距上下 2.54cm、左右 3.17cm（自研通稿口径）" },
        { "action": "setDefaultFont", "app": "word", "note": "中文宋体、西文 Times New Roman（自研口径，投稿前对目标刊复核）" },
        { "action": "setParagraph", "app": "word", "note": "正文 1.5 倍行距（自研口径）" },
        { "action": "applyStyle", "app": "word", "note": "标题黑体小二居中、一级节标题黑体四号（自研规范）" },
        { "action": "addCaption", "app": "word", "note": "图表编号规则：图题在图下、表题在表上，全文连续编号（自研规则）" },
        { "action": "getDocumentStats", "app": "word", "note": "字数核查：常见期刊正文 6000~12000 字区间（自研口径，供投稿前自查）" },
        { "action": "save", "app": "common", "note": "保存" }
      ],
      "not_for": ["学位论文", "毕业论文"],
      "confirm_before": []
    },
    {
      "task": "group_meeting_report",
      "title": "组会报告",
      "match": ["组会报告", "组会汇报", "组会PPT", "组会纪要", "实验室组会", "组会总结"],
      "steps": [
        { "action": "getRangeData", "app": "excel", "note": "读本周实验数据/进度表" },
